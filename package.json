{
  "name": "omniinbox-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "verify": "node scripts/verify-lambdas.mjs",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package-lambdas.mjs",
    "package:core": "node scripts/package-lambdas.mjs --core-only",
    "check": "node scripts/verify-lambdas.mjs && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.700.0",
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0"
  }
}
