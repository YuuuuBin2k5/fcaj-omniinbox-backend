# ==============================================================================
# OmniInbox Backend — Mẫu biến môi trường cho các hàm AWS Lambda (ap-southeast-1)
# KHÔNG điền giá trị bí mật thật vào file này hoặc commit .env.local lên Git.
# ==============================================================================

# --- Bảng Amazon DynamoDB (Hoài Nam) ---
CONVERSATIONS_TABLE=OmniConversations
MESSAGES_TABLE=OmniMessages
IDEMPOTENCY_TABLE=OmniIdempotency
WS_CONNECTIONS_TABLE=OmniWSConnections

# --- Amazon SQS & SSM Parameter Store (Hoài Nam / Vi / Duy) ---
INBOUND_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/<ACCOUNT_ID>/omni-inbound-queue
WEBHOOK_SECRET_SSM_PATH=/omniinbox/prod/webhook_secret
TELEGRAM_TOKEN_SSM_PATH=/omniinbox/prod/telegram_bot_token

# --- WebSocket Connection URL (https://..., KHÔNG dùng wss://) & CORS ---
WS_ENDPOINT=https://<WS_API_ID>.execute-api.ap-southeast-1.amazonaws.com/prod
# Dùng "*" lúc dev; đổi thành https://<CLOUDFRONT_DOMAIN> khi lên CloudFront (Ngày 8)
ALLOWED_ORIGIN=*

# --- Cờ vận hành & kiểm thử ---
ALLOW_SIMULATOR=true
# Tùy chọn bảo mật nâng cao: đặt "true" khi gắn Cognito Authorizer trên /simulator/webhook/{channel}
REQUIRE_SIMULATOR_AUTH=false
# Chỉ đặt "true" tạm thời khi test DLQ, xong bắt buộc trả về "false"
ENABLE_FAULT_INJECTION=false

# --- PHA 2 TÙY CHỌN: omni-ai-suggester (chỉ cấu hình nếu Go AI ở Ngày 9) ---
# Kiểm tra model ACTIVE bằng `aws bedrock list-foundation-models --region ap-southeast-1`
BEDROCK_MODEL_ID=
BEDROCK_REGION=ap-southeast-1
